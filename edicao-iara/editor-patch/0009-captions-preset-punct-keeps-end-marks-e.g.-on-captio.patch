From 1d55a67b74c14526380d3d8b693e2eef4495f02d Mon Sep 17 00:00:00 2001
From: gabriel20angelo-web <gabriel20angelo-web@users.noreply.github.com>
Date: Sun, 22 Nov 2026 17:30:53 -0300
Subject: [PATCH 9/9] captions: preset "punct" keeps end marks (e.g. "?!") on
 caption words; clean() keeps them

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/ai-editor/lib/ai_editor/presets.py     |  2 +-
 plugins/ai-editor/lib/ai_editor/review.py      |  2 +-
 .../skills/style-edit/scripts/plan.py          | 18 +++++++++++-------
 3 files changed, 13 insertions(+), 9 deletions(-)

diff --git a/plugins/ai-editor/lib/ai_editor/presets.py b/plugins/ai-editor/lib/ai_editor/presets.py
index 08c88ba..58a4e8c 100644
--- a/plugins/ai-editor/lib/ai_editor/presets.py
+++ b/plugins/ai-editor/lib/ai_editor/presets.py
@@ -70,7 +70,7 @@ HEX = re.compile(r"#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|#[0-9A-Fa-f]{3}")
 FIELDS = {"style": str, "font_match": str, "size_pct": (float, 1, 15), "weight": (int, 100, 900), "case": {"as_is", "lower", "upper", "sentence"},
           "words_per_caption": (int, 1, 8), "max_lines": (int, 1, 3), "y_pct": (float, 10, 95), "width_pct": (float, 30, 100),
           "color": HEX, "highlight_color": HEX, "emphasis_color": HEX, "box_color": HEX, "inactive_opacity": (float, 0, 1),
-          "active_scale": (float, 1, 2), "active_lift": (float, 0, 40), "stroke": bool, "box": bool, "shadow": bool, "present": bool, "treat": bool,
+          "active_scale": (float, 1, 2), "active_lift": (float, 0, 40), "stroke": bool, "box": bool, "shadow": bool, "present": bool, "treat": bool, "punct": str,
           "effect": {"pop", "slide", "word_highlight", "karaoke", "reveal", "lift", "none"},
           "animation": {"pop", "slide", "word_highlight", "none"}}
 
diff --git a/plugins/ai-editor/lib/ai_editor/review.py b/plugins/ai-editor/lib/ai_editor/review.py
index bd5eed5..d36690b 100644
--- a/plugins/ai-editor/lib/ai_editor/review.py
+++ b/plugins/ai-editor/lib/ai_editor/review.py
@@ -1504,7 +1504,7 @@ def lay_captions(p, cap):
     if n and n != n0:   # words at a time changed: re-paged as plan.py pages them
         from plan import chunk_captions, mark_emph
         words = [w for ch in p["captions"]["chunks"] for w in ch.get("words") or [] if "start" in w]
-        p["captions"]["chunks"] = mark_emph(chunk_captions(words, n, st.get("case", "sentence")))
+        p["captions"]["chunks"] = mark_emph(chunk_captions(words, n, st.get("case", "sentence"), st.get("punct", "")))
         st["words_per_caption"] = n
 
 
diff --git a/plugins/ai-editor/skills/style-edit/scripts/plan.py b/plugins/ai-editor/skills/style-edit/scripts/plan.py
index 9bcb87b..3221325 100644
--- a/plugins/ai-editor/skills/style-edit/scripts/plan.py
+++ b/plugins/ai-editor/skills/style-edit/scripts/plan.py
@@ -136,12 +136,16 @@ GAP_S = 10.0
 QUIET_HOLD_S = 5.0
 
 
-def clean(text):
-    return re.sub(r"[^\w'’-]+", "", text)
+def clean(text, keep=""):
+    """The word without punctuation; keep: marks that stay at the end of the word (caption "punct", e.g. "?!")."""
+    core = re.sub(r"[^\w'’-]+", "", text)
+    m = re.search(r"[^\w'’-]+$", text)
+    tail = next((ch for ch in (m.group() if m else "") if ch in keep), "")
+    return core + tail if core else ""
 
 
-def cased(text, mode):
-    text = clean(text)
+def cased(text, mode, keep=""):
+    text = clean(text, keep)
     return text.lower() if mode == "lower" else text.upper() if mode == "upper" else text
 
 
@@ -164,7 +168,7 @@ def join_hyphens(words):
     return out
 
 
-def chunk_captions(words, n, mode):
+def chunk_captions(words, n, mode, keep=""):
     chunks, cur = [], []
     words = join_hyphens(words)
     for i, w in enumerate(words):
@@ -182,7 +186,7 @@ def chunk_captions(words, n, mode):
         end = min(last["end"], last["start"] + MAX_WORD_S) + HOLD_TAIL_S
         if nxt is not None:
             end = min(end, nxt)
-        ws = [{"text": cased(w["text"], mode), "start": w["start"], "end": w["end"]} for w in c]
+        ws = [{"text": cased(w["text"], mode, keep), "start": w["start"], "end": w["end"]} for w in c]
         ws = [w for w in ws if w["text"]]
         if ws:
             out.append({"text": " ".join(w["text"] for w in ws), "start": c[0]["start"],
@@ -2544,7 +2548,7 @@ def build(style, words, meta, images=(), aspect="auto", cuts=(), visuals=(), edi
     if aspect == "9:16":   # centred captions keep the safe zone's wider side margin on both sides
         m = max(SAFE[aspect][0], SAFE[aspect][2])
         cap["width_pct"] = min(cap.get("width_pct") or 86, 100 - 2 * m)
-    chunks = mark_emph(chunk_captions(words, cap.get("words_per_caption") or 3, cap.get("case", "sentence"))) \
+    chunks = mark_emph(chunk_captions(words, cap.get("words_per_caption") or 3, cap.get("case", "sentence"), cap.get("punct", ""))) \
         if cap.get("present", True) else []
     if took(style, "captions"):
         chunks = type_pages(chunks, cap)
